#!/bin/bash

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if rg -q 'currentImage\.(copyright|title)' "$ROOT_DIR/BarWidget.qml"; then
  echo 'Bing metadata is exposed to the shared AutoText tooltip' >&2
  exit 1
fi

awk '
  /id: attributionText/ { in_attribution = 1 }
  in_attribution && /textFormat: Text\.PlainText/ { plain = 1 }
  in_attribution && /^        }/ { exit plain ? 0 : 1 }
  END { if (!in_attribution || !plain) exit 1 }
' "$ROOT_DIR/Panel.qml" || {
  echo 'Bing attribution is not explicitly rendered as plain text' >&2
  exit 1
}

printf 'QML metadata security tests passed\n'
